    "exchange": {
        "name": "delta",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "allow_inactive": true
        }
