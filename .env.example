# DELTA_ENV: india_prod | global_prod | india_testnet
DELTA_ENV=india_prod

# Delta API Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL (usually handled by DELTA_ENV)
# DELTA_BASE_URL=https://api.india.delta.exchange

# Freqtrade Configuration
# Config file to use (e.g. config.delta.dryrun.json or config.delta.live.json)
FREQTRADE_CONFIG_FILE=config.delta.dryrun.json
