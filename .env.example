# Delta Exchange Credentials
DELTA_ENV=india_prod # Options: india_prod, global_prod, india_testnet
DELTA_API_KEY=your_api_key
DELTA_API_SECRET=your_api_secret
DELTA_BASE_URL= # Optional override

# Markets & Whitelist Configuration
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt # Options: perps_usdt, all_futures, allowlist_regex
ALLOWLIST_REGEX=.* # Only used if FILTER_MODE=allowlist_regex

# Risk Controls
DAILY_LOSS_LIMIT_PCT=-0.05 # Stop entries if daily realized PnL < -5%

# Telegram / Notification (Optional)
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
