# Delta Exchange Environment (india_prod, global_prod, india_testnet)
DELTA_ENV=india_prod

# API Credentials (Permissions: Trading=Read/Write, Wallet=Read, Withdraw=NO)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL (if not set, determined by DELTA_ENV)
# DELTA_BASE_URL=https://api.india.delta.exchange

# Market Refresh Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
# Filter Mode: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt
ALLOWLIST_REGEX=.*

# Risk Management
MAX_OPEN_TRADES=10
STAKE_AMOUNT=unlimited
# Daily Loss Limit (percentage, e.g. 0.05 for 5%)
DAILY_LOSS_LIMIT=0.05

# Freqtrade Config File (default: config.delta.dryrun.json)
FREQTRADE_CONFIG_FILE=config.delta.dryrun.json
