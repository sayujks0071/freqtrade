# ==========================================
# Delta Exchange Freqtrade Configuration
# ==========================================

# Environment Selection
# Options: india_prod | global_prod | india_testnet
DELTA_ENV=india_prod

# API Credentials (REQUIRED)
# Get these from your Delta Exchange account settings
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Freqtrade UI Password (REQUIRED)
# Used to access the web interface at http://localhost:8080
FREQTRADE_API_PASSWORD=changeme

# Optional: Override Base URL manually (if needed)
# DELTA_BASE_URL=https://api.india.delta.exchange

# ------------------------------------------
# Advanced / Optional Settings
# ------------------------------------------

# Validation Settings (used by scripts)
MIN_MARKETS=10
