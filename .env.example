# Delta Exchange Environment Configuration
# Options: india_prod, global_prod, india_testnet
DELTA_ENV=india_prod

# Delta API Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL (if not using one of the presets)
# DELTA_BASE_URL=https://api.india.delta.exchange

# ------------------------------------------------------------------
# Market Validation & Refresh Settings
# ------------------------------------------------------------------

# Minimum number of markets required to pass validation
MIN_MARKETS=20

# Maximum ratio of removed pairs allowed before blocking updates (0.25 = 25%)
MAX_REMOVAL_RATIO=0.25

# Fail validation if active markets have low/zero volume (true/false)
STRICT_VOLUME=false

# Filter mode for whitelist generation:
# - perps_usdt: Linear USDT perps (default)
# - all_futures: All future types
# - allowlist_regex: Use ALLOWLIST_REGEX to match symbols
FILTER_MODE=perps_usdt

# Regex for allowlist_regex mode
ALLOWLIST_REGEX=.*
