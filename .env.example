# Delta Exchange Environment (india_prod, global_prod, india_testnet)
DELTA_ENV=india_testnet

# API Credentials (required for trading and private data)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional Base URL override
# DELTA_BASE_URL=https://api.india.delta.exchange

# Market Validation & Whitelist Generation
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt
# perps_usdt, all_futures, allowlist_regex
ALLOWLIST_REGEX=.*

# Strategy Safety
MAX_LEVERAGE=2.0

# Strategy Scouting
GITHUB_TOKEN=your_github_token_for_higher_limits
