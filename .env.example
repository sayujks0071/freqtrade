# Delta Exchange Environment (india_prod, global_prod, india_testnet)
DELTA_ENV=india_testnet

# API Credentials
DELTA_API_KEY=your_api_key
DELTA_API_SECRET=your_api_secret

# Optional Base URL Override (if not standard)
# DELTA_BASE_URL=https://api.india.delta.exchange

# Freqtrade UI Password
FREQTRADE__API_SERVER__PASSWORD=SuperSecurePassword123!

# Market Validation & Refresh Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
# FILTER_MODE: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt
ALLOWLIST_REGEX=.*USDT.*

# Strategy Settings
MAX_OPEN_TRADES=5
STAKE_AMOUNT=20
LEVERAGE=2
