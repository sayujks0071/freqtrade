# Delta Exchange Environment Configuration

# Environment: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# API Credentials (get from Delta Exchange)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional Base URL Override (e.g., specific proxy or regional endpoint)
# leave empty to use defaults based on DELTA_ENV
DELTA_BASE_URL=

# Market Validation & Whitelist Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
# FILTER_MODE options: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt
ALLOWLIST_REGEX=.*USDT:USDT

# Risk Management
MAX_LEVERAGE=2
STAKE_AMOUNT=100
MAX_OPEN_TRADES=3

# Telegram (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Freqtrade Configuration
FREQTRADE_Strategy=SampleStrategy
FREQTRADE_CONFIG_FILE=config.delta.dryrun.json
