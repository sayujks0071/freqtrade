# Delta Exchange Environment
# Options: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# API Credentials (REQUIRED)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL (if not set, defaults based on DELTA_ENV)
# DELTA_BASE_URL=https://api.india.delta.exchange

# Market Refresh Configuration
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt
# Options: perps_usdt, all_futures, allowlist_regex
ALLOWLIST_REGEX=".*"

# Strategy Scout
GITHUB_TOKEN=your_github_token_here

# Risk Limits (Optional - used by custom scripts/plugins)
MAX_DAILY_LOSS_PCT=5.0
MAX_LEVERAGE=2
