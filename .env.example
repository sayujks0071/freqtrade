# Exchange Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Environment: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# API URLs (override if needed, defaults set in scripts/configs)
# DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# Market Filtering & Whitelist Config
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt
# ALLOWLIST_REGEX=^BTC/USDT:USDT$

# Bot Configuration (default to dryrun)
FREQTRADE_CONFIG_FILE=config.delta.dryrun.json

# Strategies
FREQTRADE_STRATEGY=DeltaSafeStrategy
