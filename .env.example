# Environment configuration
# Default environment: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# API Credentials (REQUIRED for live/dry-run)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=

# Market Refresh Configuration
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
# FILTER_MODE: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt
ALLOWLIST_REGEX=.*

# Risk / Protection Configuration
# Daily Loss Limit in percentage (e.g., 0.05 = 5%)
DAILY_LOSS_LIMIT=0.05

# Database URL
DB_URL=sqlite:////freqtrade/user_data/tradesv3.sqlite
