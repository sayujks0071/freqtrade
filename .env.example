# Delta Exchange Environment (india_prod, global_prod, india_testnet)
DELTA_ENV=india_testnet

# API Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL
# DELTA_BASE_URL=https://api.india.delta.exchange

# Market Validation Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt
# FILTER_MODE options: perps_usdt, all_futures, allowlist_regex
ALLOWLIST_REGEX=.*USDT:USDT

# Risk & Strategy Settings
STAKE_AMOUNT=100
MAX_OPEN_TRADES=3
LEVERAGE=2
