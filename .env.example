# Delta Exchange Environment
# Options: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# API Credentials
# For security, use a sub-account with 'Trading' permissions only (no Withdraw).
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional overrides
# DELTA_BASE_URL=
