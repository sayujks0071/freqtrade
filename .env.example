# Delta Exchange Environment Configuration
# Options: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# Delta API Credentials
DELTA_API_KEY=your_api_key
DELTA_API_SECRET=your_api_secret

# Optional: Override Base URL (if not using one of the presets)
# DELTA_BASE_URL=https://api.india.delta.exchange

# Market Refresh & Validation Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false
FILTER_MODE=perps_usdt
# Options for FILTER_MODE: perps_usdt, all_futures, allowlist_regex
ALLOWLIST_REGEX=.*USDT
