# Delta Exchange Environment Configuration
# Options: india_prod, global_prod, india_testnet
DELTA_ENV=india_testnet

# Delta API Credentials
# Create these at https://india.delta.exchange/app/profile/api-keys or https://www.delta.exchange/app/profile/api-keys
# Permissions: Read + Trading (NO Withdrawal)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Optional: Override Base URL (if not using one of the presets)
# DELTA_BASE_URL=

# Market Refresh & Validation Settings
# Minimum number of markets required to be considered valid
MIN_MARKETS=20
# Maximum allowed removal ratio for whitelist drift check (0.25 = 25%)
MAX_REMOVAL_RATIO=0.25
# Strict Volume Filter (true/false)
STRICT_VOLUME=false
# Filter Mode: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt
# Regex for allowlist (e.g. .*USDT for USDT pairs)
ALLOWLIST_REGEX=.*USDT
