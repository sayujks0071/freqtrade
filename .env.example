# Delta Exchange Environment
# Options: india_testnet, india_prod, global_prod
DELTA_ENV=india_testnet

# Delta Exchange API Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# API Base URL Override (optional, auto-detected if empty)
# india_prod: https://api.india.delta.exchange
# global_prod: https://api.delta.exchange
# india_testnet: https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=

# Market Data Validation Settings
MIN_MARKETS=20
MAX_REMOVAL_RATIO=0.25
STRICT_VOLUME=false

# Whitelist Filtering Mode
# Options: perps_usdt, all_futures, allowlist_regex
FILTER_MODE=perps_usdt

# Regex for allowlist_regex mode (e.g. "BTC/USDT:USDT|ETH/USDT:USDT")
ALLOWLIST_REGEX=.*

# GitHub Token for Strategy Scout (optional but recommended for rate limits)
GITHUB_TOKEN=
